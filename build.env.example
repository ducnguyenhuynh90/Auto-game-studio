# Mắm Village: everything a build machine can be given, for both apps.
# Copy this file to `.env.local` (git-ignored) and fill in what you have. Never commit real values.
# EVERY setting is optional: anything left empty is simply switched off, and the game still builds
# and plays offline as a guest. Store uploads only need the SIGNING section.
#
#   3D app (Capacitor, android/ + ios/; the one in the store screenshots):
#     set -a; source .env.local; set +a
#     npm ci && npm run cap:sync
#     cd android && ./gradlew bundleRelease     # Play AAB → android/app/build/outputs/bundle/release/
#     (iOS: open ios/App/App.xcworkspace in Xcode → Product → Archive)
#   React Native app (mobile/):
#     cp .env.local mobile/.env.local && cd mobile && npm ci && npx expo prebuild && …
#     (full steps: docs/BUILD_FOR_STORES.md)
# CI does the same with GitHub → Settings → Secrets and variables → Actions (names in [brackets]).

# ───────────────────────── App identity (not secret) ─────────────────────────
# Shown to players as the version; must go up with every store upload.
MAM_VERSION_NAME=1.0.0
# Android versionCode / iOS build number: a whole number, +1 for EVERY upload (CI uses the run number).
MAM_VERSION_CODE=1
# React Native app only (the 3D app's id is fixed in capacitor.config.ts: com.mamvillage.app).
# Cannot change after the first store upload.
MAM_APP_ID=com.mamvillage.rn

# ───────────── Player accounts + cloud saves: Supabase (recommended) ─────────────
# supabase.com → New project (free) → SQL editor: run supabase/migrations/*.sql
# → Authentication → Providers: enable Anonymous, Google, Apple
# → Authentication → URL configuration → Redirect URLs: add
#     com.mamvillage.app://auth/callback   (3D app)
#     com.mamvillage.rn://auth/callback    (React Native app)
# → Project Settings → API: copy the URL and the anon/public key (public by design; RLS protects rows).
VITE_SUPABASE_URL=                 # [VITE_SUPABASE_URL]   e.g. https://abcd1234.supabase.co
VITE_SUPABASE_ANON_KEY=            # [VITE_SUPABASE_ANON_KEY]
EXPO_PUBLIC_SUPABASE_URL=${VITE_SUPABASE_URL}          # React Native app reads these names
EXPO_PUBLIC_SUPABASE_ANON_KEY=${VITE_SUPABASE_ANON_KEY}

# ───────────────────── Google Analytics 4 (optional, opt-in) ─────────────────────
# analytics.google.com → Admin → Data streams → (Web stream for the 3D app) → Measurement ID.
# For the React Native app also: the stream → Measurement Protocol API secrets → Create.
VITE_GA_MEASUREMENT_ID=            # [VITE_GA_MEASUREMENT_ID]  e.g. G-XXXXXXXXXX
VITE_GA_CONSENT=ask                # ask (players opt in after the first catch) | granted
EXPO_PUBLIC_GA_MEASUREMENT_ID=${VITE_GA_MEASUREMENT_ID}
EXPO_PUBLIC_GA_API_SECRET=         # [GA_API_SECRET]  React Native app only

# ───────────────── Android signing: Google Play upload key (secret) ─────────────────
# Create once, keep it safe forever (losing it means asking Google for a key reset):
#   keytool -genkeypair -v -keystore upload.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000
# Without these, release builds are unsigned and test APKs use the public tester key.
ANDROID_KEYSTORE_PATH=             # absolute path to upload.jks; CI: [ANDROID_KEYSTORE_BASE64] = base64 -w0 upload.jks
ANDROID_KEYSTORE_PASSWORD=         # [ANDROID_KEYSTORE_PASSWORD]
ANDROID_KEY_ALIAS=upload           # [ANDROID_KEY_ALIAS]
ANDROID_KEY_PASSWORD=              # [ANDROID_KEY_PASSWORD]

# ────────────── iOS: App Store Connect upload (secret; CI TestFlight job) ──────────────
# developer.apple.com → Membership: Team ID. appstoreconnect.apple.com → Users and Access →
# Integrations → App Store Connect API → Generate key (App Manager): Key ID, Issuer ID, download .p8.
# Building on a Mac with Xcode signed in to the team doesn't need these.
APPLE_TEAM_ID=                     # [APPLE_TEAM_ID]      10 characters, e.g. AB12CD34EF
ASC_KEY_ID=                        # [ASC_KEY_ID]
ASC_ISSUER_ID=                     # [ASC_ISSUER_ID]      a UUID
ASC_KEY_P8_BASE64=                 # [ASC_KEY_P8_BASE64]  base64 -w0 AuthKey_XXXX.p8

# ───────────── Legacy, leave empty (Firebase login; ignored when Supabase is set) ─────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
