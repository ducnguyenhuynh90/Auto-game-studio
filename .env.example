# Player accounts + cloud saves with Supabase (recommended). Leave empty to ship guest-only builds.
# 1) Create a Supabase project (free plan). 2) Run supabase/migrations/*.sql in the SQL editor.
# 3) Authentication → Providers: enable Anonymous sign-ins, and Google / Apple / Facebook if wanted.
# 4) Authentication → URL configuration: add your game's URL to the redirect allow list.
# The anon key is public by design: row-level security keeps every player to their own rows.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Alternative (older): Firebase. Ignored when Supabase is configured.
# Create a Firebase project (free Spark plan), add a Web app, enable the sign-in providers,
# deploy firestore.rules, and add your hosting domain to Authentication → Authorized domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: endpoint that accepts analytics beacons (JSON events)
VITE_ANALYTICS_URL=
