# Copy to .env.local (git-ignored) and fill in what this build should have. Expo reads it at build time.
# Everything is optional: empty = that service is off and the game plays offline.

# Cloud backup + Google / Apple sign-in (Supabase → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Analytics 4 (GA4 → Admin → Data streams; the API secret is under Measurement Protocol)
EXPO_PUBLIC_GA_MEASUREMENT_ID=
EXPO_PUBLIC_GA_API_SECRET=

# Store identity (read by app.config.js when the native project is generated)
# MAM_APP_ID=com.mamvillage.rn         # bundle id / package name; can't change after the first upload
# MAM_VERSION_NAME=1.0.0               # the version players see
# MAM_VERSION_CODE=1                   # must go up with every store upload (Android versionCode, iOS build)
